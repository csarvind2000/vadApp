FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ /app/

ENV PYTHONUNBUFFERED=1 DJANGO_SETTINGS_MODULE=vadapp.settings

# The worker only orchestrates: the heavy lifting happens in vad_model, so this
# image stays CPU-only and can be scaled independently.
CMD ["python", "manage.py", "rqworker", "default"]
