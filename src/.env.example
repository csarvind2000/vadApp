# Copy to .env and fill in real values.

VERSION=1.0.0
DEBUG=False

# Host path where uploaded videos, thumbnails and the database live.
DOCKER_ROOT=./data

# Path to the research repo (provides src/ucfcrime/*), mounted read-only into
# the model container so app and experiments share one model definition.
RESEARCH_ROOT=../..

# Directory holding the trained checkpoint as best.pt
MODELS_DIR=./models

# Django
DJANGO_SECRET_KEY=change-me-long-random-no-dollar-signs-compose-interpolates-them
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5174
CSRF_TRUSTED_ORIGINS=http://localhost:5174

# PostgreSQL
POSTGRES_DB=vadapp
POSTGRES_USER=vadapp
POSTGRES_PASSWORD=change-me

# Detector
VAD_BACKBONE=i3d_r50
VAD_THRESHOLD=0.5

# API authentication (False = open; the bundled frontend has no login flow)
VAD_REQUIRE_AUTH=False
